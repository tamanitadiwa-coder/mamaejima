# Mama Ejima frontend configuration (copy to .env.local)

# Address of your PocketBase backend.
#   Local development:  http://127.0.0.1:8090
#   Production:         https://api.<your-domain>  (Cloudflare Tunnel)
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# Sub-path the site is served from. "/mamaejima" on GitHub Pages; empty on your own domain.
NEXT_PUBLIC_BASE_PATH=
